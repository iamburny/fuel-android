<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      android.permission.INTERNET/ACCESS_FINE_LOCATION/ACCESS_COARSE_LOCATION,
      androidx.car.app.MAP_TEMPLATES, the minCarApiLevel meta-data, and the
      FuelCarAppService <service> declaration are all merged in from :core's manifest.
    -->

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />

    <application
        android:name=".FuelAutomotiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Fuel Tracker UK"
        android:supportsRtl="true">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!--
          Required launcher entry point for Android Automotive OS: hosts FuelCarAppService's
          templates directly on the car's screen. Unlike phone-projected Android Auto, AAOS has
          no separate external host app, so the templated app must provide its own bridge Activity.
        -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

    </application>
</manifest>
