<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Minimum supported Car App API level -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
          Shared Android Auto / Automotive OS entry point: nearby fuel stations POI
          experience. Identical on both platforms, so it's declared once here and
          merged into whichever app (:app or :automotive) consumes this module.
        -->
        <service
            android:name="uk.co.fuelprices.car.FuelCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

    </application>
</manifest>
