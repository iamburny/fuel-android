# Upload/release signing config for Play Store builds.
#
# Copy this file to `keystore.properties` (gitignored) and fill in real values, then create the
# keystore itself:
#
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the keystore file AND these passwords safe and backed up — you need them to sign every
# future update. (With Play App Signing, a lost upload key can be reset via Play support, but the
# passwords still guard your uploads.)
#
# `storeFile` is resolved relative to the repository root.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
