<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Used by the Unleash Android SDK to avoid wasted polls when offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <!-- Required by FirebaseAnalytics.getInstance() (AppModule) — surfaced as a lint error only
         once compileSdk 36's permission metadata picked this up; app-release.aab shipping without
         it did work, but this is the correct fix rather than suppressing the check. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Minimum supported Car App API level -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
          Shared Android Auto / Automotive OS entry point: nearby fuel stations POI
          experience. Identical on both platforms, so it's declared once here and
          merged into whichever app (:app or :automotive) consumes this module.
        -->
        <service
            android:name="uk.co.fuelprices.car.FuelCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

    </application>
</manifest>
