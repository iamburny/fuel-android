<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      android.permission.INTERNET/ACCESS_FINE_LOCATION/ACCESS_COARSE_LOCATION,
      androidx.car.app.MAP_TEMPLATES, the minCarApiLevel meta-data, and the
      FuelCarAppService <service> declaration are all merged in from :core's manifest.
    -->

    <!-- Runtime-requested on Android 13+ (see MainActivity); needed to show price-drop alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FuelApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Fuel Tracker UK"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuelPrices">

        <!-- From MAPS_API_KEY in local.properties (not checked into version control) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links. autoVerify triggers Android to fetch
              https://fueltracker.uk/.well-known/assetlinks.json and, if this app's
              package + signing-cert SHA-256 match, open fueltracker.uk links directly
              (no browser disambiguation, and no other app can claim the domain).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fueltracker.uk" />
            </intent-filter>
        </activity>

        <!-- FCM service for push notifications -->
        <service
            android:name=".FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
